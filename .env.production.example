# Salin fail ini kepada .env pada server produksi. Jangan commit .env sebenar.
APP_ENV=production
APP_URL=https://pkdkb.epejabat.net
APP_DISPLAY_ERRORS=0
APP_LOG_ERRORS=1

# Gunakan nilai 32 aksara heksadesimal yang sama dengan
# system_settings.installation_instance bagi pangkalan data sasaran.
APP_INSTANCE=REPLACE_WITH_32_HEX_INSTANCE

DB_HOST=localhost
DB_PORT=3306
DB_NAME=CPANEL_DATABASE_NAME
DB_USER=CPANEL_DATABASE_USER
DB_PASSWORD=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD
