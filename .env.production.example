# Salin fail ini kepada .env pada server produksi. Jangan commit .env sebenar.
APP_ENV=production
APP_URL=https://pkdkb.epejabat.net
APP_DISPLAY_ERRORS=0
APP_LOG_ERRORS=1

# Jana dengan: php -r 'echo bin2hex(random_bytes(16)), PHP_EOL;'
# Nilai mesti sama dengan system_settings.installation_instance bagi upgrade.
APP_INSTANCE=<32-char-hex>

DB_HOST=localhost
DB_PORT=3306
DB_NAME=epejabat_sistem
DB_USER=CPANEL_DATABASE_USER
DB_PASSWORD=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD

# Akaun/organisasi awal untuk --mode=fresh. Nilai berpetik boleh mengandungi
# ruang. WAJIB tukar kata laluan contoh; runner akan menolaknya di production.
DEFAULT_ADMIN_NAME="Pentadbir Sistem"
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_EMAIL=admin@epejabat.net
DEFAULT_ADMIN_PASS=Password1234!
DEFAULT_ORG_NAME="Pejabat Kesihatan Daerah Kota Bharu"
DEFAULT_ORG_CODE=PKDKB
